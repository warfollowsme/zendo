#!/usr/bin/env bash
# Исходники Zen для справки: селекторы, CSS-переменные, настройки, модули.
#   bin/zen-source   — скачать (если нет) или обновить до последней версии
#
# Это неглубокий клон zen-browser/desktop (только последний коммит).
# Не правь его — изменения пропадут при обновлении. Свои правки — в profile/.
source "$(dirname "$0")/_lib.sh"

REPO="https://github.com/zen-browser/desktop.git"

if [ ! -d "$KIT_ZEN_SOURCE/.git" ]; then
  info "Cloning $REPO → zen-source/"
  git clone --depth 1 "$REPO" "$KIT_ZEN_SOURCE"
else
  info "Updating zen-source/"
  git -C "$KIT_ZEN_SOURCE" fetch --depth 1 origin
  git -C "$KIT_ZEN_SOURCE" reset --hard FETCH_HEAD
fi
# Внешний диск (exFAT): macOS кладёт рядом служебные ._-файлы, и git потом
# спотыкается о них в .git/objects/pack («non-monotonic index»).
find "$KIT_ZEN_SOURCE" -name '._*' -type f -delete 2>/dev/null
ok "Zen source $(zen_source_version || echo '?') ($(git -C "$KIT_ZEN_SOURCE" log -1 --format='%h, %cd' --date=short))"
