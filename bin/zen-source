#!/usr/bin/env bash
# Zen sources for reference: selectors, CSS variables, prefs, modules.
#   bin/zen-source   — download (if missing) or update to the latest version
#
# A shallow clone of zen-browser/desktop (latest commit only).
# Don't edit it — changes are lost on update. Your edits go in profile/.
source "$(dirname "$0")/_lib.sh"

REPO="https://github.com/zen-browser/desktop.git"

if [ ! -d "$KIT_ZEN_SOURCE/.git" ]; then
  info "Cloning $REPO → zen-source/"
  git clone --depth 1 "$REPO" "$KIT_ZEN_SOURCE"
else
  info "Updating zen-source/"
  git -C "$KIT_ZEN_SOURCE" fetch --depth 1 origin
  git -C "$KIT_ZEN_SOURCE" reset --hard FETCH_HEAD
fi
# External disk (exFAT): macOS puts ._ metadata files alongside, and git then
# trips over them in .git/objects/pack ("non-monotonic index").
find "$KIT_ZEN_SOURCE" -name '._*' -type f -delete 2>/dev/null
ok "Zen source $(zen_source_version || echo '?') ($(git -C "$KIT_ZEN_SOURCE" log -1 --format='%h, %cd' --date=short))"
