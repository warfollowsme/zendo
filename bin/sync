#!/usr/bin/env bash
# Builds the Zen profile from the base (this repo) and the personal layer ($ZENDO_USER).
#   bin/sync          — update the profile's links and user.js
#   bin/sync --quiet  — same, without output (as bin/mod, bin/launch… call it)
#
# In the profile's chrome/:
#   userChrome.css, userContent.css, resources, utils — links to the base;
#   user      — link to the personal layer;
#   JS/, CSS/ — folders of links to base and personal files
#               (a personal file replaces a base one of the same name);
#   kit/      — same for themes, mods and site styles; theme.css, mods.css,
#               sites.css — links to the user's selection ($ZENDO_USER/current/).
# The profile's user.js is built from profile/user.js and $ZENDO_USER/user.js.
#
# Run it after adding or removing a file in the personal layer; Zen can stay
# open. Exit code 3: the project is not connected to a profile yet (bin/install).
source "$(dirname "$0")/_lib.sh"

QUIET=0
[ "${1:-}" = "--quiet" ] && QUIET=1
say() { [ "$QUIET" = 1 ] || ok "$@"; }

[ -f "$KIT_STATE/profile" ] || { [ "$QUIET" = 1 ] || warn "Not installed yet — run bin/install"; exit 3; }
PROFILE="$(cat "$KIT_STATE/profile")"
[ -d "$PROFILE" ] || { [ "$QUIET" = 1 ] || warn "Profile not found: $PROFILE — run bin/install"; exit 3; }
CHROME="$PROFILE/chrome"
mkdir -p "$CHROME"

# ---- personal layer: fill in what's missing from the skeleton (folders, current/*.css, user.js)

mkdir -p "$ZENDO_USER"
while IFS= read -r f; do
  [ -n "$f" ] || continue
  if [ ! -e "$ZENDO_USER/$f" ]; then
    mkdir -p "$(dirname "$ZENDO_USER/$f")"
    cp "$KIT_SKEL/$f" "$ZENDO_USER/$f"
    say "created $ZENDO_USER/${f#./}"
  fi
done <<EOF
$(cd "$KIT_SKEL" && find . -type f ! -name '._*' ! -name .DS_Store | sort)
EOF

# ---- links

# link_to SRC DEST — DEST becomes a link to SRC; foreign files are left alone
link_to() {
  local src="$1" dest="$2"
  [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ] && return 0
  if [ -L "$dest" ] || [ -e "$dest" ]; then
    if ! is_ours "$dest"; then
      warn "skipped ${dest#"$PROFILE"/}: not created by this project (bin/install moves it to a backup)"
      return 0
    fi
    rm -rf "$dest"
  fi
  ln -s "$src" "$dest"
  say "${dest#"$PROFILE"/} → $src"
}

# merge_dir DEST BASE USER — folder DEST with links to the files of BASE and USER
merge_dir() {
  local dest="$1" base="$2" user="$3" names name p
  if [ -L "$dest" ]; then
    is_ours "$dest" || { warn "skipped ${dest#"$PROFILE"/}: not created by this project"; return 0; }
    rm "$dest" # the whole folder used to be a single link to the base
  fi
  mkdir -p "$dest"
  names="$({ ls -A "$base" 2>/dev/null; ls -A "$user" 2>/dev/null; } |
    grep -v -e '^\._' -e '^\.DS_Store$' -e '^\.gitkeep$' | sort -u || true)"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if [ -e "$user/$name" ]; then
      link_to "$user/$name" "$dest/$name"
    else
      link_to "$base/$name" "$dest/$name"
    fi
  done <<EOF
$names
EOF
  # links to deleted files
  for p in "$dest"/* "$dest"/.[!.]*; do
    [ -L "$p" ] || continue
    if ! printf '%s\n' "$names" | grep -qxF "$(basename "$p")"; then
      rm "$p"
      say "removed ${p#"$PROFILE"/}"
    fi
  done
}

for src in "$KIT_CHROME_SRC"/*; do
  [ -e "$src" ] || continue
  name="$(basename "$src")"
  case "$name" in
    JS|CSS) merge_dir "$CHROME/$name" "$src" "$ZENDO_USER/$name" ;;
    kit)
      if [ -L "$CHROME/kit" ] && is_ours "$CHROME/kit"; then rm "$CHROME/kit"; fi
      mkdir -p "$CHROME/kit"
      for k in "$src"/*; do
        [ -e "$k" ] || continue
        case "$(basename "$k")" in
          themes|mods|sites) merge_dir "$CHROME/kit/$(basename "$k")" "$k" "$ZENDO_USER/$(basename "$k")" ;;
          *) link_to "$k" "$CHROME/kit/$(basename "$k")" ;;
        esac
      done
      for k in theme mods sites; do
        link_to "$ZENDO_USER/current/$k.css" "$CHROME/kit/$k.css"
      done
      for p in "$CHROME/kit"/*; do # links to things no longer in the base
        if [ -L "$p" ] && [ ! -e "$p" ]; then rm "$p"; fi
      done
      ;;
    *) link_to "$src" "$CHROME/$name" ;;
  esac
done
link_to "$ZENDO_USER" "$CHROME/user"

# ---- user.js: base, then personal prefs (the last value wins)

USERJS="$PROFILE/user.js"
tmp="$USERJS.tmp.$$"
{
  printf '%s — do not edit by hand.\n' "$SYNC_MARK"
  printf '// Base: %s\n// Personal: %s (comes below and overrides the base)\n\n' "$KIT_PROFILE_SRC/user.js" "$ZENDO_USER/user.js"
  cat "$KIT_PROFILE_SRC/user.js"
  printf '\n// ==== %s ====\n\n' "$ZENDO_USER/user.js"
  cat "$ZENDO_USER/user.js" 2>/dev/null || true
} > "$tmp"
if [ -e "$USERJS" ] && ! is_ours "$USERJS"; then
  rm -f "$tmp"
  warn "skipped user.js: not created by this project (bin/install moves it to a backup)"
elif [ -f "$USERJS" ] && [ ! -L "$USERJS" ] && cmp -s "$tmp" "$USERJS"; then
  rm -f "$tmp"
else
  rm -f "$USERJS" # this used to be a link to profile/user.js
  mv "$tmp" "$USERJS"
  say "user.js rebuilt (applies after a Zen restart)"
fi

say "Profile is in sync: $PROFILE"
