#!/usr/bin/env bash
# Browser UI mods: profile/chrome/kit/mods/*.css and your own in $ZENDO_USER/mods/
#   bin/mod                 — list (● enabled)
#   bin/mod on <name> [...] — enable
#   bin/mod off <name> [...] — disable
source "$(dirname "$0")/_lib.sh"
TOGGLE_KIND=mods
TOGGLE_CMD=mod
TOGGLE_TITLE="Interface mods"
source "$(dirname "$0")/_toggle.sh"
toggle_main "$@"
