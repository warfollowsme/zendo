#!/usr/bin/env bash
# Make the Zendo launcher, which starts Zen via bin/launch.
#   macOS: bin/app            — build /Applications/Zendo.app
#          bin/app <folder>   — build it in another folder (e.g. ~/Applications)
#   Linux: bin/app            — add Zendo to the applications menu
#                               (~/.local/share/applications/zendo.desktop)
#
# It only holds a link to this project folder; the launch logic is in bin/launch,
# so rebuild only after moving the project. Icon: assets/Zendo.icns / zendo.png
# (drawn by assets/make-icon.swift), otherwise the Zen icon.
source "$(dirname "$0")/_lib.sh"

if ! is_macos; then
  APPS="${1:-${XDG_DATA_HOME:-$HOME/.local/share}/applications}"
  mkdir -p "$APPS"
  cat > "$APPS/zendo.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Zendo
GenericName=Web Browser
Comment=Starts Zen after checking the script loader and the profile
Exec="$KIT_ROOT/bin/launch"
Icon=$KIT_ROOT/assets/zendo.png
Categories=Network;WebBrowser;
StartupWMClass=zen
Terminal=false
EOF
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$APPS" >/dev/null 2>&1 || true
  fi
  ok "Added $APPS/zendo.desktop → $KIT_ROOT/bin/launch"
  info "Find Zendo in the applications menu and pin it instead of Zen."
  exit 0
fi

DEST="${1:-/Applications}/Zendo.app"
RES="$(detect_app_resources)" || die "Zen application not found in /Applications"

ICON="$(/usr/bin/defaults read "$(cd "$RES/.." && pwd -P)/Info" CFBundleIconFile 2>/dev/null || true)"
ICON="${ICON%.icns}"

rm -rf "$DEST"
mkdir -p "$DEST/Contents/MacOS" "$DEST/Contents/Resources"

cat > "$DEST/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Zendo</string>
  <key>CFBundleDisplayName</key><string>Zendo</string>
  <key>CFBundleIdentifier</key><string>local.zendo.launcher</string>
  <key>CFBundleExecutable</key><string>Zendo</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleIconFile</key><string>Zendo</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
EOF

if [ -f "$KIT_ROOT/assets/Zendo.icns" ]; then
  cp "$KIT_ROOT/assets/Zendo.icns" "$DEST/Contents/Resources/Zendo.icns"
elif [ -n "$ICON" ] && [ -f "$RES/$ICON.icns" ]; then
  cp "$RES/$ICON.icns" "$DEST/Contents/Resources/Zendo.icns"
fi

cat > "$DEST/Contents/MacOS/Zendo" <<EOF
#!/bin/bash
# Zendo: launches Zen through the project at $KIT_ROOT (built by bin/app).
if [ ! -x "$KIT_ROOT/bin/launch" ]; then
  /usr/bin/osascript -e 'display alert "Zendo" message "Project folder not found: $KIT_ROOT. If you moved the project, run bin/app in it." as warning'
  exec /usr/bin/open -a Zen
fi
exec "$KIT_ROOT/bin/launch"
EOF
chmod +x "$DEST/Contents/MacOS/Zendo"
touch "$DEST"

ok "Built $DEST → $KIT_ROOT/bin/launch"
info "Drag it to the Dock in place of Zen."
