#!/usr/bin/env bash
# Launches Zen with everything the project needs. Called by Zendo.app (bin/app).
#   bin/launch   — check and open Zen
#
# Before launching:
#   - the script loader (fx-autoconfig) is in place in the Zen app — a Zen update
#     erases it, so put it back and clear the script cache;
#   - the Zen profile is connected to this folder — if the project moved or links
#     are broken, reconnect via bin/install;
#   - the profile is built from the base and personal layer (bin/sync): new personal files
#     and user.js changes reach the profile.
# If Zen is already open, just brings it forward. Log: .kit/launch.log.
source "$(dirname "$0")/_lib.sh"

mkdir -p "$KIT_STATE"
exec >>"$KIT_STATE/launch.log" 2>&1
printf '\n== %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"

alert() {
  /usr/bin/osascript -e 'on run argv' -e 'display alert "Zendo" message (item 1 of argv) as warning' -e 'end run' "$1" >/dev/null 2>&1 || true
}

RES="$(detect_app_resources)" || { alert "Zen not found in /Applications. Install Zen: https://zen-browser.app"; exit 1; }
APP="$(cd "$RES/../.." && pwd -P)"

if zen_running; then
  info "Zen already running"
  "$KIT_ROOT/bin/sync" --quiet || true
  exec /usr/bin/open -a "$APP"
fi

# Script loader in the Zen app.
if ! cmp -s "$RES/config.js" "$KIT_ROOT/program/config.js" ||
   ! cmp -s "$RES/defaults/pref/config-prefs.js" "$KIT_ROOT/program/defaults/pref/config-prefs.js"; then
  info "Script loader missing in $RES (Zen updated?) — reinstalling"
  if ! "$KIT_ROOT/bin/install" --autoconfig; then
    alert "Could not restore the script loader in Zen (details: $KIT_STATE/launch.log). Zen will open without scripts."
  fi
fi

# The profile is connected to this folder.
PROFILE="$(active_profile)" || PROFILE=""
if [ -n "$PROFILE" ] && { [ "$(readlink "$PROFILE/chrome/userChrome.css" 2>/dev/null)" != "$KIT_CHROME_SRC/userChrome.css" ] ||
                          [ "$(cat "$KIT_STATE/profile" 2>/dev/null)" != "$PROFILE" ]; }; then
  info "Profile is not linked to $KIT_ROOT — running bin/install"
  "$KIT_ROOT/bin/install" || alert "Could not connect the Zen profile to $KIT_ROOT (details: $KIT_STATE/launch.log)."
else
  "$KIT_ROOT/bin/sync" || alert "Could not build the profile (details: $KIT_STATE/launch.log)."
fi

exec /usr/bin/open -a "$APP"
