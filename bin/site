#!/usr/bin/env bash
# Per-site styles: profile/chrome/kit/sites/*.css and your own in $ZENDO_USER/sites/
#   bin/site                 — list (● enabled)
#   bin/site on <name> [...] — enable
#   bin/site off <name> [...] — disable
source "$(dirname "$0")/_lib.sh"
TOGGLE_KIND=sites
TOGGLE_CMD=site
TOGGLE_TITLE="Site styles"
source "$(dirname "$0")/_toggle.sh"
toggle_main "$@"
