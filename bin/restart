#!/usr/bin/env bash
# Restarts Zen to pick up changes in CSS, user.js and scripts.
#   bin/restart               — quit and reopen Zen
#   bin/restart --clear-cache — also clear the startup cache (needed after JS edits)
source "$(dirname "$0")/_lib.sh"

CLEAR=0
[ "${1:-}" = "--clear-cache" ] && CLEAR=1

"$KIT_ROOT/bin/sync" --quiet || true # personal files and user.js go to the profile

if zen_running; then
  info "Quitting Zen…"
  if is_macos; then
    APP="$(cd "$(detect_app_resources)/../.." && pwd -P)"
    osascript -e "tell application \"$(basename "$APP" .app)\" to quit" >/dev/null 2>&1 || true
  else
    pkill -x zen 2>/dev/null || pkill -x zen-bin 2>/dev/null || pkill -x zen-browser 2>/dev/null || true
  fi
  for _ in $(seq 1 40); do
    zen_running || break
    sleep 0.25
  done
  zen_running && die "Zen did not quit within 10 seconds — close it manually."
fi
if [ "$CLEAR" = 1 ]; then
  PROFILE="$(require_active_profile)"
  clear_startup_cache "$PROFILE"
fi
start_zen || die "Zen not found — launch it manually."
ok "Zen started"
