#!/usr/bin/env bash
# Restarts Zen to pick up changes in CSS, user.js and scripts.
#   bin/restart               — quit and reopen Zen
#   bin/restart --clear-cache — also clear the startup cache (needed after JS edits)
source "$(dirname "$0")/_lib.sh"

CLEAR=0
[ "${1:-}" = "--clear-cache" ] && CLEAR=1

"$KIT_ROOT/bin/sync" --quiet || true # personal files and user.js go to the profile

if is_macos; then
  RES="$(detect_app_resources)" || die "Zen.app not found"
  APP="$(cd "$RES/../.." && pwd -P)"
  APP_NAME="$(basename "$APP" .app)"
  if zen_running; then
    info "Quitting $APP_NAME…"
    osascript -e "tell application \"$APP_NAME\" to quit" >/dev/null 2>&1 || true
    for _ in $(seq 1 40); do
      zen_running || break
      sleep 0.25
    done
    zen_running && die "Zen did not quit within 10 seconds — close it manually."
  fi
  if [ "$CLEAR" = 1 ]; then
    PROFILE="$(require_active_profile)"
    clear_startup_cache "$PROFILE"
  fi
  open -a "$APP"
  ok "Zen started"
else
  if zen_running; then
    pkill -x zen 2>/dev/null || pkill -x zen-bin 2>/dev/null || true
    for _ in $(seq 1 40); do zen_running || break; sleep 0.25; done
  fi
  if [ "$CLEAR" = 1 ]; then
    PROFILE="$(require_active_profile)"
    clear_startup_cache "$PROFILE"
  fi
  command -v zen >/dev/null 2>&1 || die "zen is not in PATH — launch Zen manually."
  nohup zen >/dev/null 2>&1 &
  ok "Zen started"
fi
