#!/usr/bin/env bash
# Quick check of the base and personal layer without launching Zen:
#   - every @import points to an existing file;
#   - themes have @name, @scheme and all 7 --theme-* variables;
#   - mods and site styles have @name and @description;
#   - curly braces in CSS are balanced;
#   - JS scripts are syntactically valid (if node is installed);
#   - the tests in tests/ pass (if node is installed).
source "$(dirname "$0")/_lib.sh"

errors=0
fail() { printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$*"; errors=$((errors + 1)); }

rel() {
  case "$1" in
    "$KIT_ROOT"/*) printf '%s\n' "${1#"$KIT_ROOT"/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Where an @import points: paths in userChrome.css and current/*.css are relative to
# the profile folders built by bin/sync (kit/ and user/).
import_target() {
  local css="$1" target="$2" kind
  case "$css" in
    "$KIT_CHROME_SRC/userChrome.css"|"$KIT_CHROME_SRC/userContent.css")
      case "$target" in
        kit/theme.css|kit/mods.css|kit/sites.css) target="${target#kit/}"; printf '%s\n' "$ZENDO_USER/current/$target" ;;
        user/*) printf '%s\n' "$ZENDO_USER/${target#user/}" ;;
        *) printf '%s\n' "$KIT_CHROME_SRC/$target" ;;
      esac ;;
    "$ZENDO_USER/current/"*)
      case "$target" in
        themes/*|mods/*|sites/*)
          kind="${target%%/*}"; target="${target#*/}"
          kit_file "$kind" "${target%.css}" || printf '%s\n' "$ZENDO_USER/$kind/$target" ;;
        *) printf '%s\n' "$KIT_KIT_DIR/$target" ;;
      esac ;;
    *) printf '%s\n' "$(dirname "$css")/$target" ;;
  esac
}

css_files() {
  find "$KIT_CHROME_SRC" -name '*.css' -not -name '._*' -not -path '*/utils/*'
  [ -d "$ZENDO_USER" ] && find "$ZENDO_USER" -name '*.css' -not -name '._*' -not -path '*/.git/*'
  return 0
}

# 1. @import and braces
while IFS= read -r css; do
  [ -n "$css" ] || continue
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    t="$(import_target "$css" "$target")"
    case "$t" in "$ZENDO_USER"/*) [ -d "$ZENDO_USER" ] || continue ;; esac # not installed yet
    [ -f "$t" ] || fail "$(rel "$css"): @import \"$target\" — file not found"
  done <<EOF
$(sed -n 's/^@import url("\([^"]*\)")[^;]*;.*$/\1/p' "$css")
EOF
  opens="$(tr -cd '{' < "$css" | wc -c | tr -d ' ')"
  closes="$(tr -cd '}' < "$css" | wc -c | tr -d ' ')"
  [ "$opens" = "$closes" ] || fail "$(rel "$css"): unbalanced braces: { $opens, } $closes"
done <<EOF
$(css_files | sort)
EOF

# 2. Themes
for f in "$KIT_KIT_DIR"/themes/*.css "$ZENDO_USER"/themes/*.css; do
  [ -e "$f" ] || continue
  [ -n "$(css_meta "$f" name)" ] || fail "$(rel "$f"): missing @name"
  case "$(css_meta "$f" scheme)" in
    dark|light) ;;
    *) fail "$(rel "$f"): @scheme must be dark or light" ;;
  esac
  for v in scheme bg surface fg muted accent border; do
    grep -q -- "--theme-$v:" "$f" || fail "$(rel "$f"): missing --theme-$v"
  done
done

# 3. Mods and sites
for f in "$KIT_KIT_DIR"/mods/*.css "$KIT_KIT_DIR"/sites/*.css "$ZENDO_USER"/mods/*.css "$ZENDO_USER"/sites/*.css; do
  [ -e "$f" ] || continue
  [ -n "$(css_meta "$f" name)" ] || fail "$(rel "$f"): missing @name"
  [ -n "$(css_meta "$f" description)" ] || fail "$(rel "$f"): missing @description"
done
for f in "$KIT_KIT_DIR"/sites/*.css "$ZENDO_USER"/sites/*.css; do
  [ -e "$f" ] || continue
  grep -q '@-moz-document' "$f" || fail "$(rel "$f"): site rules must be inside @-moz-document"
done

# 4. JS
js_checked=0
if command -v node >/dev/null 2>&1; then
  for f in "$KIT_CHROME_SRC"/JS/*.uc.js "$KIT_CHROME_SRC"/JS/*.uc.mjs "$KIT_CHROME_SRC"/JS/*.sys.mjs \
           "$ZENDO_USER"/JS/*.uc.js "$ZENDO_USER"/JS/*.uc.mjs "$ZENDO_USER"/JS/*.sys.mjs; do
    [ -e "$f" ] || continue
    out="$(node --check "$f" 2>&1)" || fail "$(rel "$f"): $out"
    js_checked=$((js_checked + 1))
    grep -q '// ==UserScript==' "$f" || fail "$(rel "$f"): missing // ==UserScript== header"
  done
  # site scripts (JS/kit-site-scripts.sys.mjs) — domains in the header
  for f in "$KIT_KIT_DIR"/sites/*.js "$ZENDO_USER"/sites/*.js; do
    [ -e "$f" ] || continue
    out="$(node --check "$f" 2>&1)" || fail "$(rel "$f"): $out"
    js_checked=$((js_checked + 1))
    grep -q '^// @domain' "$f" || fail "$(rel "$f"): missing // @domain in the ==UserScript== header"
    kit_file sites "$(basename "$f" .js)" >/dev/null ||
      fail "$(rel "$f"): needs a site style $(basename "$f" .js).css — the script is enabled with it"
  done
  # modules for scripts (actors etc.) — no header, syntax only
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    out="$(node --check "$f" 2>&1)" || fail "$(rel "$f"): $out"
    js_checked=$((js_checked + 1))
  done <<EOF
$(find "$KIT_CHROME_SRC/resources" -name '*.mjs' -not -name '._*' 2>/dev/null | sort)
EOF
  # tests: what the AI assistant may do without asking (resources/kit-ai/policy.sys.mjs)
  for f in "$KIT_ROOT"/tests/*.test.mjs; do
    [ -e "$f" ] || continue
    out="$(node "$f" 2>&1)" || fail "$(rel "$f"): $out"
  done
else
  warn "node is not installed — JS syntax was not checked"
fi

# 5. bin/ scripts
for f in "$KIT_ROOT"/bin/* "$KIT_ROOT"/install.sh; do
  [ -f "$f" ] || continue
  out="$(bash -n "$f" 2>&1)" || fail "$(rel "$f"): $out"
  # git doesn't see permissions here (core.fileMode=false): check what a clone gets
  case "$(basename "$f")" in _*) continue ;; esac
  mode="$(git -C "$KIT_ROOT" ls-files -s -- "$f" 2>/dev/null | cut -d' ' -f1)"
  if [ -n "$mode" ] && [ "$mode" != 100755 ]; then
    fail "$(rel "$f"): not executable in git — git update-index --chmod=+x $(rel "$f")"
  fi
done

if [ "$errors" = 0 ]; then
  ok "Check passed (JS files checked: $js_checked)"
else
  die "Errors: $errors"
fi
